  "question": {
    "html": "<p>A rigid body with a moment of inertia <span class=\"math\" data-latex=\"I\"></span> is initially at rest. A constant net torque <span class=\"math\" data-latex=\"\\Gamma\"></span> is applied to the body. Which expression represents the rotational kinetic energy of the body after time <span class=\"math\" data-latex=\"t\"></span>?</p><ol class=\"mcq-options\"><li data-label=\"A\"><p><span class=\"math\" data-latex=\"\\frac{\\Gamma t}{I}\"></span></p></li><li data-label=\"B\"><p><span class=\"math\" data-latex=\"\\Gamma t\"></span></p></li><li data-label=\"C\"><p><span class=\"math\" data-latex=\"\\frac{\\Gamma^{2} t^{2}}{2 I}\"></span></p></li><li data-label=\"D\"><p><span class=\"math\" data-latex=\"\\frac{\\Gamma^{2} t}{2 I}\"></span></p></li></ol>"
  },
