  "markscheme": {
    "html": "<section class=\"markscheme-part\" data-label=\"6a\"><p><strong>6a</strong></p><p></p>\n<p>Different isotopes of the same element have the same number of protons, but a different number of neutrons.</p>\n<p></p></section><section class=\"markscheme-part\" data-label=\"6b\"><p><strong>6b</strong></p><p></p>\n<p><span class=\"math\" data-latex=\"_{\\, \\, \\, 87}^{223}\\textrm{Fr} \\rightarrow _{\\, \\, \\, 88}^{223}\\textrm{Ra} + _{-1}^{\\, \\, \\, \\, 0}\\textrm{e} + _{0}^{0}\\textrm{}\\overline{v}_{e}\"></span></p>\n<p></p></section><section class=\"markscheme-part\" data-label=\"6c\"><p><strong>6c</strong></p><p> </p>\n<p>\n<figure data-asset-id=\"fig_02\"><img alt=\"Source markscheme diagram 2\" src=\"asset:fig_02\"/></figure>\n</p>\n<p> </p></section>"
