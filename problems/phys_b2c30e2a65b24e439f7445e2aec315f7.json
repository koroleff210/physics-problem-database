  "markscheme": {
    "html": "<section class=\"markscheme-part\" data-label=\"3a\"><p><strong>3a</strong></p><p> </p>\n<p>\n<figure data-asset-id=\"fig_05\"><img alt=\"Source markscheme diagram 5\" src=\"asset:fig_05\"/></figure>\n</p>\n<p> </p></section><section class=\"markscheme-part\" data-label=\"3b\"><p><strong>3b</strong></p><p></p>\n<p>Position B labeled.</p>\n<p></p></section><section class=\"markscheme-part\" data-label=\"3c\"><p><strong>3c</strong></p><p></p>\n<p><span class=\"math\" data-latex=\"\\frac{1}{2}(43)(0.38)^{2} = \\frac{1}{2}(0.28)v^{2}\"></span></p>\n<p><span class=\"math\" data-latex=\"v \\approx 4.7\"></span> m s<span class=\"math\" data-latex=\"^{-1}\"></span></p>\n<p></p></section><section class=\"markscheme-part\" data-label=\"3d\"><p><strong>3d</strong></p><p> </p>\n<p>\n<figure data-asset-id=\"fig_06\"><img alt=\"Source markscheme diagram 6\" src=\"asset:fig_06\"/></figure>\n</p>\n<p> </p></section>"
