  "question": {
    "html": "<p>What is the formula for the magnetic force on a particle of charge <span class=\"math\" data-latex=\"q\"></span> moving at speed <span class=\"math\" data-latex=\"v\"></span> in a magnetic field of strength <span class=\"math\" data-latex=\"B\"></span> at right angles to the field?</p><ol class=\"mcq-options\"><li data-label=\"A\"><p><span class=\"math\" data-latex=\"F = qvB\"></span></p></li><li data-label=\"B\"><p><span class=\"math\" data-latex=\"F = \\frac{qB}{v}\"></span></p></li><li data-label=\"C\"><p><span class=\"math\" data-latex=\"F = \\frac{v}{qB}\"></span></p></li><li data-label=\"D\"><p><span class=\"math\" data-latex=\"F = qB^2v\"></span></p></li></ol>"
  },
