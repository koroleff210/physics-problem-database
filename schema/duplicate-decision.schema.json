{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V4 reviewed duplicate decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_canonical_ids", "v4_ids", "decision", "decided_at", "basis", "notes"],
  "properties": {
    "source_canonical_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "v4_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^phys_[0-9a-f]{32}$" }
    },
    "decision": { "enum": ["confirmed_duplicate", "kept_separate"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["normalized_text", "formulas", "images", "answer_content", "source_reference", "manual_comparison"] }
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "confirmed_duplicate" } } },
      "then": { "properties": { "v4_ids": { "maxItems": 1 } } }
    },
    {
      "if": { "properties": { "decision": { "const": "kept_separate" } } },
      "then": { "properties": { "v4_ids": { "minItems": 2 } } }
    }
  ]
}
